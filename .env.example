# Copia este archivo como ".env.local" y pega tu clave.
# ".env.local" está en .gitignore: NUNCA se sube a GitHub.
# En Vercel se configura aparte: Project > Settings > Environment Variables.

# Clave de la YouTube Data API v3 (Google Cloud > APIs y servicios > Credenciales).
# Sin ella la app funciona igual, pero solo se agregan canciones pegando el enlace.
YOUTUBE_API_KEY=
